# App
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://agendabot:agendabot_secret@localhost:5432/agendabot_dev?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# JWT — troque por strings longas e aleatórias em produção
JWT_SECRET=change-this-to-a-random-32-char-minimum-string
JWT_REFRESH_SECRET=change-this-to-another-random-32-char-minimum-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# URLs
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173
