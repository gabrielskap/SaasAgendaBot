# App
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# JWT — troque por strings longas e aleatórias em produção
JWT_SECRET=change-this-to-a-random-32-char-minimum-string
JWT_REFRESH_SECRET=change-this-to-another-random-32-char-minimum-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# URLs
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173

# uazapi (WhatsApp)
UAZAPI_BASE_URL=https://quantumtecnologia.uazapi.com
UAZAPI_GLOBAL_TOKEN=change-this-to-your-uazapi-global-token
UAZAPI_TOKEN_INSTANCE=change-this-to-your-instance-token

# Webhook — configure o URL abaixo no painel UAZAPI como Webhook URL:
# https://<seu-dominio>/whatsapp/webhook
# O token da instância UAZAPI é usado como autenticação (campo "token" no payload)
